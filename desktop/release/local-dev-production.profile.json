{
  "profile": "local-dev-production",
  "bundle_identifier": "xyz.block.buzz.app",
  "keyring_service": "buzz-desktop",
  "debug_keyring_service": "buzz-desktop-dev",
  "relay_ws_url": "ws://localhost:3300",
  "expected_owner_pubkey_prefix": "ea840b3e",
  "frontend": {
    "mode": "frontendDist",
    "path": "../dist",
    "dev_url_active": false
  },
  "compile_env": {
    "BUZZ_DESKTOP_BUILD_RELAY_URL": "ws://localhost:3300",
    "BUZZ_DESKTOP_IMMUTABLE_PROFILE": "1"
  },
  "state_root": {
    "macos": "${HOME}/Library/Application Support/xyz.block.buzz.app",
    "linux_test": "${XDG_STATE_HOME:-${HOME}/.local/state}/xyz.block.buzz.app"
  },
  "log_root": {
    "macos": "${HOME}/Library/Logs/xyz.block.buzz.app",
    "linux_test": "${XDG_STATE_HOME:-${HOME}/.local/state}/xyz.block.buzz.app/logs"
  },
  "forbidden_runtime_roots": [
    "source-checkout",
    "dawsos-reports",
    "dawsos-ops",
    "reports/ops"
  ],
  "buzz_transport": "optional",
  "mention_seats": "not-added",
  "pairing": "unchanged"
}
